// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  ADMIN
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

enum DocumentType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
}

enum DocumentStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

enum LedgerType {
  RECEIPT
  DELIVERY
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum AdjustmentReason {
  DAMAGE
  LOSS
  FOUND
  CORRECTION
  STOCK_COUNT
  OTHER
}

// =====================================================
// USER
// =====================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(WAREHOUSE_STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdDocuments     InventoryDocument[] @relation("CreatedDocuments")
  responsibleDocuments InventoryDocument[] @relation("ResponsibleDocuments")
  warehouses           Warehouse[]         @relation("WarehouseManager")
  otpTokens            OtpToken[]
}

// =====================================================
// OTP / PASSWORD RESET
// =====================================================

model OtpToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// =====================================================
// WAREHOUSE
// =====================================================

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  shortCode String   @unique
  address   String?
  managerId String?
  manager   User?    @relation("WarehouseManager", fields: [managerId], references: [id])

  locations Location[]
  products  StockBalance[]
  documents InventoryDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shortCode])
}

// =====================================================
// LOCATION
// =====================================================

model Location {
  id          String   @id @default(cuid())
  name        String
  shortCode   String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children Location[] @relation("LocationHierarchy")

  stockBalances StockBalance[]
  ledgerEntries StockLedger[]

  fromLines InventoryDocumentLine[] @relation("FromLocation")
  toLines   InventoryDocumentLine[] @relation("ToLocation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, shortCode])
  @@index([warehouseId])
}

// =====================================================
// PRODUCT CATEGORY
// =====================================================

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// =====================================================
// UNIT OF MEASURE
// =====================================================

model UnitOfMeasure {
  id        String    @id @default(cuid())
  name      String
  symbol    String
  products  Product[]
  createdAt DateTime  @default(now())

  @@unique([name])
  @@unique([symbol])
}

// =====================================================
// PRODUCT
// =====================================================

model Product {
  id           String           @id @default(cuid())
  name         String
  sku          String           @unique
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  uomId        String
  uom          UnitOfMeasure    @relation(fields: [uomId], references: [id])
  unitCost     Decimal          @db.Decimal(12, 2)
  active       Boolean          @default(true)
  initialStock Decimal?         @db.Decimal(12, 3)

  stockBalances StockBalance[]
  documentLines InventoryDocumentLine[]
  ledgerEntries StockLedger[]
  reorderRules  ReorderRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([categoryId])
}

// =====================================================
// STOCK BALANCE
// =====================================================

model StockBalance {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  onHand    Decimal  @default(0) @db.Decimal(12, 3)
  reserved  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([warehouseId])
  @@index([locationId])
}

// =====================================================
// INVENTORY DOCUMENT
// =====================================================

model InventoryDocument {
  id            String         @id @default(cuid())
  reference     String         @unique
  type          DocumentType
  status        DocumentStatus @default(DRAFT)
  warehouseId   String
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  scheduledDate DateTime?

  createdById   String
  createdBy     User           @relation("CreatedDocuments", fields: [createdById], references: [id])
  responsibleId String?
  responsible   User?          @relation("ResponsibleDocuments", fields: [responsibleId], references: [id])
  supplierId    String?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  notes         String?

  lines InventoryDocumentLine[]

  receipt    Receipt?
  delivery   Delivery?
  transfer   Transfer?
  adjustment Adjustment?

  ledgerEntries StockLedger[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([warehouseId])
  @@index([type])
  @@index([status])
  @@index([scheduledDate])
}

// =====================================================
// DOCUMENT LINE
// =====================================================

model InventoryDocumentLine {
  id              String            @id @default(cuid())
  documentId      String
  document        InventoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  quantity        Decimal           @db.Decimal(12, 3)
  countedQuantity Decimal?          @db.Decimal(12, 3)
  unitCost        Decimal?          @db.Decimal(12, 2)

  fromLocationId String?
  fromLocation   Location? @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     Location? @relation("ToLocation", fields: [toLocationId], references: [id])

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([productId])
  @@index([fromLocationId])
  @@index([toLocationId])
}

// =====================================================
// RECEIPT
// =====================================================

model Receipt {
  id         String            @id @default(cuid())
  documentId String            @unique
  document   InventoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
}

// =====================================================
// DELIVERY
// =====================================================

model Delivery {
  id              String            @id @default(cuid())
  documentId      String            @unique
  document        InventoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  deliveryAddress String?
  createdAt       DateTime          @default(now())
}

// =====================================================
// INTERNAL TRANSFER
// =====================================================

model Transfer {
  id         String            @id @default(cuid())
  documentId String            @unique
  document   InventoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
}

// =====================================================
// STOCK ADJUSTMENT
// =====================================================

model Adjustment {
  id         String            @id @default(cuid())
  documentId String            @unique
  document   InventoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reason     AdjustmentReason?
  createdAt  DateTime          @default(now())
}

// =====================================================
// SUPPLIER
// =====================================================

model Supplier {
  id        String              @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  documents InventoryDocument[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// =====================================================
// CUSTOMER
// =====================================================

model Customer {
  id        String              @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  documents InventoryDocument[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// =====================================================
// REORDER RULE
// =====================================================

model ReorderRule {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId      String?
  minimumStock    Decimal  @db.Decimal(12, 3)
  maximumStock    Decimal? @db.Decimal(12, 3)
  reorderQuantity Decimal? @db.Decimal(12, 3)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([locationId])
}

// =====================================================
// STOCK LEDGER
// =====================================================

model StockLedger {
  id            String             @id @default(cuid())
  productId     String
  product       Product            @relation(fields: [productId], references: [id])
  locationId    String
  location      Location           @relation(fields: [locationId], references: [id])
  documentId    String?
  document      InventoryDocument? @relation(fields: [documentId], references: [id])
  type          LedgerType
  quantity      Decimal            @db.Decimal(12, 3)
  balanceBefore Decimal            @db.Decimal(12, 3)
  balanceAfter  Decimal            @db.Decimal(12, 3)
  createdAt     DateTime           @default(now())

  @@index([productId])
  @@index([locationId])
  @@index([documentId])
  @@index([createdAt])
}
