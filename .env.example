# Backend / Database Configuration
# Prisma Postgres (pooled) — get your URL from https://console.prisma.io
DATABASE_URL="postgres://<api-key>:<secret>@pooled.db.prisma.io:5432/postgres?sslmode=require"
PORT=5000
NODE_ENV=development
JWT_SECRET="your_strong_jwt_secret_here"
JWT_EXPIRES_IN="7d"

# Frontend Configuration
VITE_API_URL="http://localhost:5000/api"
